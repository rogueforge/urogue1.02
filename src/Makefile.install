#
# Makefile for installing and linking urogue
#

CC = cc -O
CHOWN= /etc/chown
CHGRP= chgrp
RM = /bin/rm -f
INSTALLDIR = /usr/local/la
UROGUE = /usr/games/urogue
LIB = ur.lib
URUSER= daemon
URGROUP= daemon
URMODE= 4511

all:		urogue control namefinder lav

control:	control.o tunable.o
		$(CC) control.o tunable.o -o control

urogue:		$(LIB) tunable.o
		$(CC) -o urogue $(LIB) tunable.o -lcurses -ltermlib

namefinder:	namefinder.o tunable.o
		$(CC) namefinder.o tunable.o -o namefinder

lav:		lav.o
		$(CC) lav.o -o lav

install:	all
		install -s -o $(URUSER) -g $(URGROUP) -m $(URMODE) urogue $(UROGUE)
		install -s -g kmem -m 2511 lav $(INSTALLDIR)

uninstall:	uninit clean
		$(RM) $(UROGUE)

uninit:		namefinder
		$(RM) `namefinder`

clean:		
		$(RM) urogue control namefinder lav tunable.o core

init:		namefinder uninit
		touch `namefinder`
		$(CHOWN) $(URUSER) `namefinder`
		$(CHGRP) $(URGROUP) `namefinder`
